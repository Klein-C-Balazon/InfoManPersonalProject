rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DATABASE DOCUMENTATION & ARCHITECTURE
     *
     * Core Philosophy:
     * This ruleset implements a Role-Based Access Control (RBAC) model combined with strict User-Ownership. 
     * Access is bifurcated between 'admin' users (who have broad oversight for analytics and moderation) 
     * and 'standard' users (who are restricted to their own profiles and data entries).
     */

    // --- Helper Functions ---

    /** Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** 
     * Checks if the requesting user has the 'admin' role. 
     * Handles cases where the user document might not exist yet.
     */
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /** Checks if the user is the owner of the document based on the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Checks if the current user's profile is not blocked. */
    function isNotBlocked() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlocked == false;
    }

    // --- Collection Rules ---

    /**
     * @path /users/{userId}
     * Owners can manage themselves; Admins can search and block/unblock.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (resource != null && (isOwner(userId) || isAdmin())) && (request.resource.data.id == resource.data.id);
      allow delete: if resource != null && isAdmin();
    }

    /**
     * @path /visits/{visitId}
     * Users record their own visits; Admins perform aggregate analytics.
     */
    match /visits/{visitId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 100);
      allow create: if isSignedIn() && isNotBlocked() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if resource != null && isAdmin();
    }

    /**
     * @path /colleges/{collegeId}
     * Master list of colleges, publicly readable for UI selection.
     */
    match /colleges/{collegeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
